# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Community Cloud -> App settings -> Secrets. Never commit real keys.

GOOGLE_API_KEY = "your-gemini-key"     # required for the app's shared key (free tier works)

# Optional overrides
# GEMINI_MODEL = "gemini-3.5-flash"
# GEMINI_FALLBACK_MODEL = "gemini-2.5-flash"
# QUESTION_CAP = "20"

# Optional extra providers (each appears in the sidebar once its key is set)
# GROQ_API_KEY = ""
# OPENAI_API_KEY = ""
# ANTHROPIC_API_KEY = ""

# Optional LangSmith tracing
# LANGSMITH_TRACING = "true"
# LANGSMITH_API_KEY = ""
# LANGSMITH_PROJECT = "ipl-rag"
